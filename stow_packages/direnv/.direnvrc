# Activate a uv-managed venv. Defaults to ./.venv; pass a path to override.
# Creates the venv via `uv venv` if missing. Use in a project's .envrc as:  use uv
use_uv() {
    local venv="${1:-.venv}"
    if [[ ! -d "$venv" ]]; then
        if command -v uv >/dev/null 2>&1; then
            log_status "creating venv at $venv via uv"
            uv venv "$venv" || return 1
        else
            log_error "no $venv directory and uv is not on PATH"
            return 1
        fi
    fi
    export VIRTUAL_ENV="$(expand_path "$venv")"
    PATH_add "$VIRTUAL_ENV/bin"
}

layout_anaconda() {
    local ANACONDA_HOME="${HOME}/mambaforge/"
    PATH_add "$ANACONDA_HOME"/bin

    if [ -n "$1" ]; then
        # Explicit environment name from layout command.
        local env_name="$1"
        source activate ${env_name}
    elif (grep -q name: environment.yml); then
        # Detect environment name from `environment.yml` file in `.envrc` directory
        source activate $(grep name: environment.yml | sed -e 's/name: //' | cut -d "'" -f 2 | cut -d '"' -f 2)
    else
        (echo >&2 No environment specified)
        exit 1
    fi
}
